# Copy file này thành .env rồi dán API key.
OPENAI_API_KEY=

# Text + web research
OPENAI_TEXT_MODEL=gpt-5.6-luna

# Image background generation
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
MAX_AI_IMAGES_PER_PROJECT=6
# Approximate per-image estimates for 1536x1024 GPT Image 1 Mini; adjust as pricing changes.
IMAGE_COST_LOW_USD=0.006
IMAGE_COST_MEDIUM_USD=0.015
IMAGE_COST_HIGH_USD=0.052

# Text-to-speech
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# 1 = không gọi API, dùng dữ liệu demo và voice im lặng.
DEMO_MODE=0
MAX_SCENES=60
